[Unit]
Description=BI-PoRB public Ethereum and Bitcoin source health
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=porb
Group=porb
WorkingDirectory=/opt/bi-porb
Environment=PORB_STATUS_DIR=/var/lib/bi-porb/status
ExecStart=/usr/bin/python3 -m service.chain_health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/bi-porb
