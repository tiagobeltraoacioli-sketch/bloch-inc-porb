/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/aml/*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow

/portal/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/atlas.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
